
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: #080808;
    color: white;
}

/* NAVIGATION */

header {
    background: #050505;
    padding: 22px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    border-bottom: 1px solid #b8860b;
}

.logo {
    font-size: 27px;
    font-weight: 800;
    letter-spacing: 2px;
}

.logo span,
h2 span,
footer span {
    color: #d4af37;
}

nav {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
}

nav a {
    color: white;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: 0.3s;
}

nav a:hover {
    color: #d4af37;
}

/* HERO SECTION */

.hero {
    min-height: 650px;
    padding: 70px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 45px;
    flex-wrap: wrap;
    background:
        radial-gradient(circle at 80% 50%, #28200b, #080808 60%);
}

.hero-text {
    max-width: 550px;
}

.hero-text h3 {
    color: #d4af37;
    letter-spacing: 4px;
    font-size: 14px;
}

.hero-text h1 {
    font-size: 48px;
    margin: 20px 0;
    line-height: 1.2;
}

.hero-text h1 span {
    color: #d4af37;
}

.hero-text h2 {
    font-size: 20px;
    color: #eee;
    margin-bottom: 20px;
}

.hero-text p {
    color: #aaa;
    line-height: 1.9;
    margin-bottom: 25px;
}

/* MAIN PHOTO */

.hero-image {
    width: 400px;
    max-width: 100%;
    padding: 9px;
    border-radius: 25px;
    background: linear-gradient(135deg, #d4af37, #fff0a0, #8b6914);
    box-shadow: 0 0 35px #d4af3740;
    overflow: hidden;
}

.hero-image img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    object-position: center 35%;
    display: block;
    border-radius: 18px;
    transition: 0.5s;
}

.hero-image:hover img {
    transform: scale(1.04);
}

/* BUTTONS */

.btn {
    display: inline-block;
    padding: 14px 28px;
    background: #d4af37;
    color: black;
    text-decoration: none;
    font-weight: 700;
    border-radius: 5px;
    transition: 0.4s;
}

.btn:hover {
    background: white;
    transform: translateY(-5px);
}

/* ABOUT */

.about {
    padding: 90px 8%;
    background: #111;
    text-align: center;
}

.about h2,
.gallery h2,
.contact h2 {
    font-size: 35px;
    margin-bottom: 40px;
}

.about-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 50px;
    flex-wrap: wrap;
}

.about-image img {
    width: 300px;
    height: 350px;
    object-fit: cover;
    object-position: center 35%;
    border: 4px solid #d4af37;
    border-radius: 15px;
}

.about-text {
    max-width: 500px;
    text-align: left;
}

.about-text h3 {
    font-size: 26px;
    color: #d4af37;
    margin-bottom: 20px;
}

.about-text p {
    color: #bbb;
    line-height: 2;
    margin-bottom: 15px;
}

/* GALLERY */

.gallery {
    padding: 90px 8%;
    text-align: center;
    background: #080808;
}

.gallery p {
    color: #aaa;
}

.gallery-container {
    display: flex;
    justify-content: center;
    margin-top: 40px;
}

.photo {
    width: 320px;
    background: #171717;
    border: 1px solid #d4af37;
    border-radius: 15px;
    overflow: hidden;
    transition: 0.4s;
}

.photo:hover {
    transform: translateY(-10px);
    box-shadow: 0 10px 30px #d4af3740;
}

.photo img {
    width: 100%;
    height: 350px;
    object-fit: cover;
    object-position: center 35%;
}

.photo h3 {
    color: #d4af37;
    padding: 18px;
}

/* MOTIVATION */

.motivation {
    padding: 80px 10%;
    text-align: center;
    background: linear-gradient(120deg, #332606, #080808);
}

.motivation h2 {
    color: #d4af37;
    font-size: 30px;
    margin-bottom: 20px;
}

.motivation p {
    font-size: 20px;
    font-style: italic;
    color: white;
}

/* CONTACT */

.contact {
    padding: 80px 10%;
    text-align: center;
    background: #111;
}

.contact p {
    color: #aaa;
    margin-bottom: 25px;
}

/* FOOTER */

footer {
    background: black;
    text-align: center;
    padding: 35px 15px;
    border-top: 1px solid #d4af37;
}

footer h2 {
    margin-bottom: 10px;
}

footer p {
    color: #999;
    font-size: 13px;
    margin-top: 8px;
}

/* MOBILE DESIGN */

@media(max-width: 768px) {

    header {
        justify-content: center;
        text-align: center;
        gap: 20px;
    }

    nav {
        justify-content: center;
        gap: 15px;
    }

    .hero {
        justify-content: center;
        text-align: center;
    }

    .hero-text h1 {
        font-size: 35px;
    }

    .hero-image {
        width: 330px;
    }

    .hero-image img {
        height: 400px;
    }

    .about-content {
        flex-direction: column;
    }

    .about-text {
        text-align: center;
    }
}
